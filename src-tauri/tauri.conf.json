{
  "productName": "FlowPlayer",
  "version": "0.1.0",
  "identifier": "com.flowplayer.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "FlowPlayer",
        "width": 1024,
        "height": 768,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "decorations": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: tauri: asset:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost; frame-src 'none'",
      "capabilities": [
        {
          "identifier": "default-capability",
          "description": "Default capabilities for the app",
          "permissions": [
            "core:default",
            "core:event:allow-listen",
            "core:window:allow-show",
            "shell:allow-open"
          ]
        }
      ]
    }
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}